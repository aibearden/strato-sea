# Required for live AIS. Get a key at https://aisstream.io/
AISSTREAM_API_KEY=

# Optional overrides
# AISSTREAM_URL=wss://stream.aisstream.io/v0/stream
# VESSEL_TTL_SECONDS=600
# CORS_ORIGINS=http://localhost:5173
# HOST=0.0.0.0
# PORT=8000

